rules_version = '2';
// Family-link sharing: there are no accounts. Each farm lives under a long random
// code (the part after # in the family link). Anyone who knows the code can open and
// edit that farm; nobody can list farms to discover codes.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function validCode(id) { return id.size() >= 20 && id.size() <= 80; }

    match /farms/{farmId} {
      allow get, create, update: if validCode(farmId);
      allow list, delete: if false;

      match /items/{itemId} {
        allow read, write: if validCode(farmId);
      }
      match /snapshots/{snapId} {
        allow read, create: if validCode(farmId);
        allow update: if false;
        // Backups can only be tidied away once they are over 30 days old.
        allow delete: if resource.data.atMs < request.time.toMillis() - 2592000000;
      }
    }
  }
}
